#!/usr/bin/env bash
set -euo pipefail

github_user={{ remote_agent_dev_github_user | quote }}
agent_user={{ remote_agent_dev_user | quote }}
agent_group={{ remote_agent_dev_user | quote }}
agent_home={{ remote_agent_dev_user_home | quote }}
ssh_dir="${agent_home}/.ssh"
authorized_keys="${ssh_dir}/authorized_keys"
tmp_keys="$(mktemp)"
tmp_authorized_keys=""
lock_file="/run/sync-agent-github-keys.lock"
managed_block_start="# BEGIN github.com/${github_user}.keys (managed)"
managed_block_end="# END github.com/${github_user}.keys (managed)"

cleanup() {
  rm -f "${tmp_keys}"
  if [[ -n "${tmp_authorized_keys}" ]]; then
    rm -f "${tmp_authorized_keys}"
  fi
}
trap cleanup EXIT

install -d -o "${agent_user}" -g "${agent_group}" -m 0700 "${ssh_dir}"
touch "${authorized_keys}"
chown "${agent_user}:${agent_group}" "${authorized_keys}"
chmod 0600 "${authorized_keys}"

curl --fail --silent --show-error --location "https://github.com/${github_user}.keys" \
  | sed '/^[[:space:]]*$/d' > "${tmp_keys}"

if [[ ! -s "${tmp_keys}" ]]; then
  echo "No GitHub public keys found for ${github_user}" >&2
  exit 1
fi

{
  flock -x 9
  tmp_authorized_keys="$(mktemp "${ssh_dir}/.authorized_keys.XXXXXX")"

  # Preserve non-GitHub entries, remove the prior managed block, and migrate
  # keys appended by older versions of this script into the managed block.
  awk \
    -v block_start="${managed_block_start}" \
    -v block_end="${managed_block_end}" \
    'function emit(line) {
       if (line ~ /^[[:space:]]*$/) {
         trailing_whitespace = trailing_whitespace line ORS
       } else {
         printf "%s", trailing_whitespace
         print line
         trailing_whitespace = ""
       }
     }
     NR == FNR {
       github_keys[$1 " " $2] = 1
       next
     }
     $0 == block_start { in_managed_block = 1; next }
     $0 == block_end { in_managed_block = 0; next }
     !in_managed_block && !(($1 " " $2) in github_keys) { emit($0) }' \
    "${tmp_keys}" "${authorized_keys}" > "${tmp_authorized_keys}"

  if [[ -s "${tmp_authorized_keys}" ]]; then
    printf '\n' >> "${tmp_authorized_keys}"
  fi
  printf '%s\n' "${managed_block_start}" >> "${tmp_authorized_keys}"
  cat "${tmp_keys}" >> "${tmp_authorized_keys}"
  printf '%s\n' "${managed_block_end}" >> "${tmp_authorized_keys}"

  chown "${agent_user}:${agent_group}" "${tmp_authorized_keys}"
  chmod 0600 "${tmp_authorized_keys}"
  mv -f "${tmp_authorized_keys}" "${authorized_keys}"
  tmp_authorized_keys=""
} 9>"${lock_file}"
