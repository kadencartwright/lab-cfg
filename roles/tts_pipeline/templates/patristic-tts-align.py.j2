#!{{ tts_pipeline_alignment_venv }}/bin/python
import argparse
import json
import math
import re
from pathlib import Path

import soundfile as sf
import stable_whisper

WORD = re.compile(r"[^\W_]+(?:[’'\-][^\W_]+)*", re.UNICODE)

def chunks(text: str, limit: int = 750):
    paragraphs = [re.sub(r"\s+", " ", p).strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    for paragraph in paragraphs:
        sentences = re.split(r"(?<=[.!?])\s+", paragraph)
        current = ""
        for sentence in sentences:
            if current and len(current) + len(sentence) + 1 > limit:
                yield current
                current = sentence
            else:
                current = f"{current} {sentence}".strip()
        if current:
            yield current

def main():
    parser = argparse.ArgumentParser(description="Force-align Kokoro narration at word level")
    parser.add_argument("--input", required=True, type=Path)
    parser.add_argument("--master", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()

    text_chunks = list(chunks(args.input.read_text(encoding="utf-8")))
    audio_chunks = sorted(args.master.with_suffix(args.master.suffix + ".chunks").glob("*.wav"))
    if len(text_chunks) != len(audio_chunks):
        raise SystemExit(f"Chunk mismatch: {len(text_chunks)} text, {len(audio_chunks)} audio")

    model = stable_whisper.load_model("{{ tts_pipeline_alignment_model }}", device="cpu")
    words = []
    estimated_tail_words = 0
    offset = 0.0
    for index, (text, audio) in enumerate(zip(text_chunks, audio_chunks), start=1):
        result = model.align(str(audio), text, language="en", fast_mode=True, regroup=False, verbose=None)
        if result is None:
            raise RuntimeError(f"Alignment failed for chunk {index}")
        aligned = [word for segment in result.segments for word in (segment.words or [])]
        for word in aligned:
            words.append({"word": word.word.strip(), "start": round(offset + word.start, 3), "end": round(offset + word.end, 3)})
        duration = sf.info(audio).duration
        expected = [match.group(0) for match in WORD.finditer(text)]
        if len(aligned) < len(expected):
            missing = expected[len(aligned):]
            start = aligned[-1].end if aligned else 0.0
            available = duration - start
            if available >= 0.05 * len(missing):
                weights = [max(1.0, math.pow(sum(character.isalnum() for character in word), 0.55)) for word in missing]
                cursor = start
                for word, weight in zip(missing, weights):
                    word_duration = available * weight / sum(weights)
                    words.append({"word": word, "start": round(offset + cursor, 3), "end": round(offset + cursor + word_duration, 3)})
                    cursor += word_duration
                estimated_tail_words += len(missing)
        offset += duration
        if index < len(audio_chunks):
            offset += 0.45
        print(f"Aligned chunk {index}/{len(audio_chunks)}: {len(aligned)} words", flush=True)

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps({"version": 2, "method": "whisper-forced-alignment", "estimatedTailWords": estimated_tail_words, "words": words}, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
    print(f"Forced timings: {args.output} ({len(words)} words; {estimated_tail_words} tail fallbacks)")

if __name__ == "__main__":
    main()
