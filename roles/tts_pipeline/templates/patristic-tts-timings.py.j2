import argparse
import json
import math
import re
from pathlib import Path

import soundfile as sf

WORD = re.compile(r"[^\W_]+(?:[’'\-][^\W_]+)*", re.UNICODE)

def chunks(text: str, limit: int = 750):
    paragraphs = [re.sub(r"\s+", " ", p).strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    for paragraph in paragraphs:
        sentences = re.split(r"(?<=[.!?])\s+", paragraph)
        current = ""
        for sentence in sentences:
            if current and len(current) + len(sentence) + 1 > limit:
                yield current
                current = sentence
            else:
                current = f"{current} {sentence}".strip()
        if current:
            yield current

def main():
    parser = argparse.ArgumentParser(description="Create word timings from Kokoro synthesis chunks")
    parser.add_argument("--input", required=True, type=Path)
    parser.add_argument("--master", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()

    text_chunks = list(chunks(args.input.read_text(encoding="utf-8")))
    audio_chunks = sorted(args.master.with_suffix(args.master.suffix + ".chunks").glob("*.wav"))
    if len(text_chunks) != len(audio_chunks):
        raise SystemExit(f"Chunk mismatch: {len(text_chunks)} text, {len(audio_chunks)} audio")

    words = []
    offset = 0.0
    for index, (text, audio) in enumerate(zip(text_chunks, audio_chunks)):
        duration = sf.info(audio).duration
        tokens = [match.group(0) for match in WORD.finditer(text)]
        weights = [max(1.0, math.pow(sum(character.isalnum() for character in token), 0.55)) for token in tokens]
        total = sum(weights)
        cursor = offset
        for token, weight in zip(tokens, weights):
            token_duration = duration * weight / total
            words.append({"word": token, "start": round(cursor, 3), "end": round(cursor + token_duration, 3)})
            cursor += token_duration
        offset += duration
        if index < len(audio_chunks) - 1:
            offset += 0.45

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps({"version": 1, "method": "kokoro-chunk-timing", "words": words}, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
    print(f"Timings: {args.output} ({len(words)} words)")

if __name__ == "__main__":
    main()
